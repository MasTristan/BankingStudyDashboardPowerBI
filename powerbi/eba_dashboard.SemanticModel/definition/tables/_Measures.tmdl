table _Measures
	lineageTag: 18383eb4-62d5-448e-a63b-8cf4f7f17e53

	measure 'Avg Ratio' =

			AVERAGEX(FACT_RATIOS, FACT_RATIOS[VALUE])
		formatString: 0.0%
		lineageTag: 103c9cbb-5e62-4780-937e-d245ada29d14

	measure 'Latest Value' =

			CALCULATE(
			    AVERAGE(FACT_RATIOS[VALUE]),
			    LASTDATE(DIM_DATE[REFERENCE_DATE])
			)
		formatString: 0.0%
		lineageTag: 90866e7e-5bd7-4bbf-9fed-b9e832a2d9ba

	measure 'Latest NB Value' =

			// Last quarter that actually has data in the current filter context.
			// Robust to sources with different coverage (TRANSPARENCY stops at 2024-Q2).
			VAR LastDataDate = CALCULATE(MAX(fact_ratios[REFERENCE_DATE]))
			RETURN
			    CALCULATE(
			        AVERAGE(fact_ratios[VALUE]),
			        fact_ratios[REFERENCE_DATE] = LastDataDate
			    )
		formatString: 0.0%
		lineageTag: 2d97c0f5-bd5c-4623-9197-43523879b2ed

	measure 'Nb Banks' =

			DISTINCTCOUNT(FACT_RATIOS[BANK_ID])
		formatString: 0
		lineageTag: 41fca5ce-60db-4273-87e8-2b232ee81523

	measure 'Nb Countries' =

			DISTINCTCOUNT(FACT_RATIOS[COUNTRY_CODE])
		formatString: 0
		lineageTag: b6e562ea-e2b1-4141-95fe-92b842f4838c

	measure 'YoY Change' =

			VAR CurrentValue = [Latest Value]
			VAR PriorYearValue =
			    CALCULATE(
			        AVERAGE(FACT_RATIOS[VALUE]),
			        DATEADD(DIM_DATE[REFERENCE_DATE], -1, YEAR)
			    )
			RETURN
			    DIVIDE(CurrentValue - PriorYearValue, PriorYearValue, BLANK())
		formatString: +0.0%;-0.0%;0.0%
		lineageTag: 9d575e65-3704-4862-b1b1-3995ded92849

	measure 'YoY Change bps' =

			VAR CurrentValue = [Latest Value]
			VAR PriorYearValue =
			    CALCULATE(
			        AVERAGE(FACT_RATIOS[VALUE]),
			        DATEADD(DIM_DATE[REFERENCE_DATE], -1, YEAR)
			    )
			RETURN
			    (CurrentValue - PriorYearValue) * 10000
		formatString: +#,##0;-#,##0;0
		lineageTag: 3fe7b73a-c5dc-4816-8cb7-73be68985ea2

	measure 'Rolling 4Q Avg' =

			AVERAGEX(
			    DATESINPERIOD(
			        DIM_DATE[REFERENCE_DATE],
			        LASTDATE(DIM_DATE[REFERENCE_DATE]),
			        -4,
			        QUARTER
			    ),
			    [Avg Ratio]
			)
		formatString: 0.0%
		lineageTag: eff8ad39-f140-442f-8da8-a34f52a5cdd2

	measure 'Avg Regulatory Buffer' =

			VAR MinThreshold = MAX(DIM_INDICATOR[REGULATORY_MIN])
			VAR BaseValue = [Latest NB Value]
			RETURN
			    IF(
			        NOT ISBLANK(MinThreshold) && NOT ISBLANK(BaseValue),
			        BaseValue - MinThreshold,
			        BLANK()
			    )
		formatString: +0.0%;-0.0%;0.0%
		lineageTag: 631f67bc-0227-4d46-b3ab-49ec83886f78

	measure 'Pct Banks Below Min' =

			VAR MinThreshold = MAX(DIM_INDICATOR[REGULATORY_MIN])
			RETURN
			    IF(
			        NOT ISBLANK(MinThreshold),
			        DIVIDE(
			            CALCULATE(
			                DISTINCTCOUNT(FACT_RATIOS[BANK_ID]),
			                FACT_RATIOS[VALUE] < MinThreshold
			            ),
			            [Nb Banks],
			            0
			        ),
			        BLANK()
			    )
		formatString: 0.0%
		lineageTag: 3ed50291-f4c5-447e-8946-ab195d09c188

	measure 'Compliance Status' =

			VAR MinThreshold = MAX(DIM_INDICATOR[REGULATORY_MIN])
			VAR AvgVal = [Latest NB Value]
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(MinThreshold), "N/A",
			        AvgVal >= MinThreshold * 1.2, "STRONG",
			        AvgVal >= MinThreshold, "COMPLIANT",
			        "BELOW MINIMUM"
			    )
		lineageTag: f72a71a9-e041-4b55-99dc-1aa498c12b4b

	measure 'Bank Rank Latest' =

			RANKX(
			    ALLSELECTED(DIM_BANK[BANK_NAME]),
			    [Latest NB Value],
			    ,
			    DESC,
			    Dense
			)
		formatString: 0
		lineageTag: 021b5542-b3aa-4989-9395-720b9b9cc79e

	measure 'CET1 Latest' =

			CALCULATE([Latest NB Value], dim_indicator[INDICATOR_CODE] = "CET1_FL")
