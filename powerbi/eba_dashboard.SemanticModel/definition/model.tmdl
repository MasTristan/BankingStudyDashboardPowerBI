model Model
	culture: fr-FR
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: fr-FR
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["dim_date","dim_country","dim_indicator","dim_bank","fact_ratios"]

annotation PBI_ProTooling = ["DaxQueryView_Desktop","DevMode"]

ref table dim_date
ref table dim_country
ref table dim_indicator
ref table dim_bank
ref table fact_ratios
ref table _Measures

ref cultureInfo fr-FR

